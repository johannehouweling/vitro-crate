# SPDX-License-Identifier: MIT
# Every ISA-Tox LabProcess executes one LabProtocol: its protocol record, which
# carries the step's protocol type (intendedUse) and is based on the documents the
# deposit holds for the step (#783, #799). Bioschemas LabProcess and ISA-JSON both
# give a process ONE protocol.
#
# Two node shapes, not one: with the Violation and the Warning on one path in a
# single node shape, rocrate-validator reports only the Violation.

@prefix bioschemas-prop: <https://bioschemas.org/properties/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix schema: <http://schema.org/> .
@prefix tox: <https://w3id.org/ro/crate/isa-tox/1.0/> .

tox:LabProcessExecutesAProtocol a sh:NodeShape ;
    sh:name "LabProcess executes a protocol" ;
    sh:description "An ISA-Tox LabProcess MUST execute a LabProtocol" ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?this a <https://bioschemas.org/LabProcess> .
                { ?this <https://bioschemas.org/properties/executesLabProtocol> ?record .
                  ?record <https://bioschemas.org/properties/intendedUse> <http://www.ebi.ac.uk/efo/EFO_0003789> }
                UNION
                { ?this <https://bioschemas.org/properties/executesLabProtocol> ?record .
                  ?record <https://bioschemas.org/properties/intendedUse> <http://purl.obolibrary.org/obo/OBI_0001152> }
                UNION
                { ?this <https://bioschemas.org/properties/executesLabProtocol> ?record .
                  ?record <https://bioschemas.org/properties/intendedUse> <http://purl.obolibrary.org/obo/GO_0030154> }
                UNION
                { ?this <https://bioschemas.org/properties/executesLabProtocol> ?record .
                  ?record <https://bioschemas.org/properties/intendedUse> <http://www.ebi.ac.uk/efo/EFO_0003969> }
                UNION
                { ?this <https://bioschemas.org/properties/executesLabProtocol> ?record .
                  ?record <https://bioschemas.org/properties/intendedUse> <http://www.bioassayontology.org/bao#BAO_0000523> }
                UNION
                { ?this <https://bioschemas.org/properties/executesLabProtocol> ?record .
                  ?record <https://bioschemas.org/properties/intendedUse> <http://purl.obolibrary.org/obo/OBI_0200000> }
                UNION
                { ?this <http://schema.org/additionalType> "TestSystemPreparation" }
                UNION
                { ?this <http://schema.org/additionalType> "CellCulture" }
                UNION
                { ?this <http://schema.org/additionalType> "Exposure" }
                UNION
                { ?this <http://schema.org/additionalType> "EndpointReadout" }
                UNION
                { ?this <http://schema.org/additionalType> "DataAnalysis" }
            }
        """ ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path bioschemas-prop:executesLabProtocol ;
        sh:minCount 1 ;
        sh:message "An ISA-Tox LabProcess MUST execute a LabProtocol via bioschemas:executesLabProtocol (its protocol record)" ;
        sh:severity sh:Violation ;
    ] .

tox:LabProcessExecutesOneProtocol a sh:NodeShape ;
    sh:name "LabProcess SHOULD execute one protocol" ;
    sh:description "An ISA-Tox LabProcess SHOULD execute exactly one LabProtocol" ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?this a <https://bioschemas.org/LabProcess> .
                { ?this <https://bioschemas.org/properties/executesLabProtocol> ?record .
                  ?record <https://bioschemas.org/properties/intendedUse> <http://www.ebi.ac.uk/efo/EFO_0003789> }
                UNION
                { ?this <https://bioschemas.org/properties/executesLabProtocol> ?record .
                  ?record <https://bioschemas.org/properties/intendedUse> <http://purl.obolibrary.org/obo/OBI_0001152> }
                UNION
                { ?this <https://bioschemas.org/properties/executesLabProtocol> ?record .
                  ?record <https://bioschemas.org/properties/intendedUse> <http://purl.obolibrary.org/obo/GO_0030154> }
                UNION
                { ?this <https://bioschemas.org/properties/executesLabProtocol> ?record .
                  ?record <https://bioschemas.org/properties/intendedUse> <http://www.ebi.ac.uk/efo/EFO_0003969> }
                UNION
                { ?this <https://bioschemas.org/properties/executesLabProtocol> ?record .
                  ?record <https://bioschemas.org/properties/intendedUse> <http://www.bioassayontology.org/bao#BAO_0000523> }
                UNION
                { ?this <https://bioschemas.org/properties/executesLabProtocol> ?record .
                  ?record <https://bioschemas.org/properties/intendedUse> <http://purl.obolibrary.org/obo/OBI_0200000> }
                UNION
                { ?this <http://schema.org/additionalType> "TestSystemPreparation" }
                UNION
                { ?this <http://schema.org/additionalType> "CellCulture" }
                UNION
                { ?this <http://schema.org/additionalType> "Exposure" }
                UNION
                { ?this <http://schema.org/additionalType> "EndpointReadout" }
                UNION
                { ?this <http://schema.org/additionalType> "DataAnalysis" }
            }
        """ ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path bioschemas-prop:executesLabProtocol ;
        sh:maxCount 1 ;
        sh:message "An ISA-Tox LabProcess SHOULD execute at most one LabProtocol (bioschemas:executesLabProtocol)" ;
        sh:severity sh:Warning ;
    ] .

# The protocol types ISA-Tox knows (#799). A record typed outside them leaves its step
# unrecognised, so every check for that kind of step is skipped; a warning first.
tox:ProtocolRecordTypeIsKnown a sh:NodeShape ;
    sh:name "A protocol record SHOULD carry an ISA-Tox protocol type" ;
    sh:description "The intendedUse of an executed LabProtocol SHOULD be one of the ISA-Tox protocol types" ;
    sh:targetObjectsOf bioschemas-prop:executesLabProtocol ;
    sh:property [
        a sh:PropertyShape ;
        sh:path bioschemas-prop:intendedUse ;
        sh:in (
            <http://www.ebi.ac.uk/efo/EFO_0003789>
            <http://purl.obolibrary.org/obo/OBI_0001152>
            <http://purl.obolibrary.org/obo/GO_0030154>
            <http://www.ebi.ac.uk/efo/EFO_0003969>
            <http://www.bioassayontology.org/bao#BAO_0000523>
            <http://purl.obolibrary.org/obo/OBI_0200000>
        ) ;
        sh:message "A protocol record's intendedUse SHOULD be one of the ISA-Tox protocol types: a test system preparation type, treatment protocol, assay protocol or data transformation" ;
        sh:severity sh:Warning ;
    ] .

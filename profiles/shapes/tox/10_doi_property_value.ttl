# SPDX-License-Identifier: MIT
# Identifier PropertyValue: a DOI names its scheme.
# A PropertyValue named "DOI" MUST set its propertyID to the OBI digital object
# identifier term, so the scheme is machine-resolvable.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tox: <https://w3id.org/ro/crate/isa-tox/1.0/> .
@prefix validator: <https://github.com/crs4/rocrate-validator/> .


tox:DOIPropertyValueMustHaveOBIPropertyID a sh:NodeShape ;
    sh:name "A DOI MUST name its identifier scheme" ;
    sh:description "A PropertyValue named DOI MUST set its propertyID to OBI:0002110." ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE { ?this a <http://schema.org/PropertyValue> . ?this <http://schema.org/name> "DOI" }
        """ ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:propertyID ;
        sh:minCount 1 ;
        sh:hasValue <http://purl.obolibrary.org/obo/OBI_0002110> ;
        sh:message "A DOI PropertyValue MUST set schema:propertyID to OBI:0002110 (digital object identifier)" ;
        sh:severity sh:Violation ;
    ] .

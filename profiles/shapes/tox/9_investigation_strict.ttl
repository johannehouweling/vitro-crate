# SPDX-License-Identifier: MIT
# Investigation: the root's descriptors, and the requirement to include an exposure.
# The ISA profile leaves name, description, license and datePublished optional on the
# root Investigation; this profile requires them, matching the general information
# module of the reporting standards.

@prefix ro-crate: <https://github.com/crs4/rocrate-validator/profiles/ro-crate/> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tox: <https://w3id.org/ro/crate/isa-tox/1.0/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tox:InvestigationMustHaveDescriptors a sh:NodeShape ;
    sh:name "The investigation MUST have a name, description, license and publication date" ;
    sh:description "The root Investigation MUST carry a name, a description, a license and a publication date." ;
    sh:targetClass ro-crate:RootDataEntity ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:not [ sh:hasValue "" ] ;
        sh:message "Investigation MUST have a non-empty schema:name (the study title)" ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:description ;
        sh:minCount 1 ;
        sh:message "Investigation MUST have a schema:description" ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:license ;
        sh:minCount 1 ;
        sh:message "Investigation MUST specify a schema:license, the terms under which the depositor permits reuse" ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:datePublished ;
        sh:minCount 1 ;
        sh:message "Investigation MUST have a schema:datePublished" ;
        sh:severity sh:Violation ;
    ] .

# The other tox shapes target entities that may be absent, so a crate with no
# exposure would pass them vacuously. This shape targets the root, which every crate
# has, and asks whether anything it reaches along hasPart and about is an exposure.
# Whether that exposure names a compound is ExposureRequirements' question, so a
# compound-less exposure is reported once. A SPARQL constraint, because no property
# of the root answers the finding.
tox:InvestigationMustIncludeAnExposure a sh:NodeShape ;
    sh:name "The investigation MUST include an exposure" ;
    sh:description "The root Investigation MUST include at least one Exposure that a Study or Assay is about." ;
    sh:targetClass ro-crate:RootDataEntity ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:select """
            PREFIX schema: <http://schema.org/>
            PREFIX bioschemas: <https://bioschemas.org/>
            PREFIX bioschemas-prop: <https://bioschemas.org/properties/>
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    $this (schema:hasPart|schema:about)+ ?e .
                    ?e a bioschemas:LabProcess .
                    { ?e bioschemas-prop:executesLabProtocol/bioschemas-prop:intendedUse <http://www.ebi.ac.uk/efo/EFO_0003969> }
                    UNION { ?e schema:additionalType "Exposure" }
                }
            }
        """ ;
        sh:severity sh:Violation ;
        sh:message "The Investigation MUST include an Exposure that one of its Studies or Assays is about" ;
    ] .

# SPDX-License-Identifier: MIT
# Investigation strict descriptors (folded ISA extra).
# The bundled isa-ro-crate profile leaves name/description/license/datePublished
# on the root Investigation as commented-out (optional). The ISA-Tox profile
# re-enables them as required, matching the general-information reporting module.
# It also requires the Investigation to include an Exposure (#781).

@prefix ro-crate: <https://github.com/crs4/rocrate-validator/profiles/ro-crate/> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tox: <https://w3id.org/ro/crate/isa-tox/1.0/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tox:InvestigationMustHaveDescriptors a sh:NodeShape ;
    sh:name "Investigation MUST have core descriptors" ;
    sh:description "The root Investigation MUST carry name, description, license and a published date" ;
    sh:targetClass ro-crate:RootDataEntity ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:not [ sh:hasValue "" ] ;
        sh:message "Investigation MUST have a non-empty schema:name (the study title)" ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:description ;
        sh:minCount 1 ;
        sh:message "Investigation MUST have a schema:description" ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:license ;
        sh:minCount 1 ;
        sh:message "Investigation MUST specify a schema:license — the terms under which this crate may be reused, as stated by the depositor" ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:datePublished ;
        sh:minCount 1 ;
        sh:message "Investigation MUST have a schema:datePublished" ;
        sh:severity sh:Violation ;
    ] .

# It is not toxicology if nothing is exposed to a chemical (#781). Every other tox
# shape targets a class, so a crate with no Exposure passed them all vacuously. This
# one targets the root, which every crate has, and asks whether anything the root
# reaches along hasPart and about is an Exposure. Whether that Exposure names a
# compound is tox:ExposureRequirements' question, so a compound-less Exposure is
# reported once. A SPARQL constraint rather than a property path, because no field
# on the root answers the finding: it names no property, so the gap engine reports
# it instead of asking for one.
tox:InvestigationMustIncludeAnExposure a sh:NodeShape ;
    sh:name "Investigation MUST include an Exposure" ;
    sh:description "The root Investigation MUST include at least one Exposure process" ;
    sh:targetClass ro-crate:RootDataEntity ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:select """
            PREFIX schema: <http://schema.org/>
            PREFIX bioschemas: <https://bioschemas.org/>
            PREFIX bioschemas-prop: <https://bioschemas.org/properties/>
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    $this (schema:hasPart|schema:about)+ ?e .
                    ?e a bioschemas:LabProcess .
                    { ?e bioschemas-prop:executesLabProtocol/bioschemas-prop:intendedUse <http://www.ebi.ac.uk/efo/EFO_0003969> }
                    UNION { ?e schema:additionalType "Exposure" }
                }
            }
        """ ;
        sh:severity sh:Violation ;
        sh:message "The Investigation MUST include an Exposure that one of its Studies or Assays is about" ;
    ] .

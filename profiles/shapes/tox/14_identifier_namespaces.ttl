# GENERATED by scripts/gen_identifier_shapes.py. Do not edit: change the tables in
# profiles/identifier_namespaces.py, then run the script.
#
# Identifier namespaces: an identifier MUST have the form its registry gives it.
# Every Person is identified by an ORCID iD and every Organization by a ROR ID;
# any other identifier is checked only where the crate claims its namespace. Each
# sh:pattern is derived from the record the rdfs:seeAlso beside it names: the
# Bioregistry's, vendored in profiles/vocabulary/identifier_namespaces.json. An
# identifier is a fact about what it identifies, so none may be invented to
# satisfy these shapes.

@prefix bioschemas: <https://bioschemas.org/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tox: <https://w3id.org/ro/crate/isa-tox/1.0/> .

tox:PersonMustBeIdentifiedByOrcid a sh:NodeShape ;
    sh:name "A person MUST be identified by an ORCID iD" ;
    sh:description "A Person's @id MUST be the address of the person's ORCID iD." ;
    sh:targetClass schema:Person ;
    rdfs:seeAlso <https://bioregistry.io/registry/orcid> ;
    sh:pattern "^https://orcid\\.org/" ;
    sh:message "A Person MUST be identified by an ORCID iD: its @id is https://orcid.org/ followed by the iD" ;
    sh:severity sh:Violation .

tox:OrganizationMustBeIdentifiedByRor a sh:NodeShape ;
    sh:name "An organization MUST be identified by a ROR ID" ;
    sh:description "An Organization's @id MUST be the address of the organization's ROR ID." ;
    sh:targetClass schema:Organization ;
    rdfs:seeAlso <https://bioregistry.io/registry/ror> ;
    sh:pattern "^https://ror\\.org/" ;
    sh:message "An Organization MUST be identified by a ROR ID: its @id is https://ror.org/ followed by the ID" ;
    sh:severity sh:Violation .

# Selected: every described entity whose @id starts with one of the namespaces
# below. The whole prefix is matched, so an ontology's own IRI (…/obo/ncit.owl) and
# the scheme a PropertyValue names (https://orcid.org) are not identifiers here.
tox:IdentifierMustBeWellFormed a sh:NodeShape ;
    sh:name "An identifier MUST be well-formed in its namespace" ;
    sh:description "An entity whose @id is in a registered identifier namespace MUST have the form the registry gives that namespace." ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT DISTINCT ?this WHERE {
                ?this a ?type .
                FILTER(isIRI(?this) && REGEX(STR(?this), "^(https://orcid\\\\.org/|https://ror\\\\.org/|https://pubchem\\\\.ncbi\\\\.nlm\\\\.nih\\\\.gov/compound/|https://compoundcloud\\\\.wikibase\\\\.cloud/entity/|https://www\\\\.cellosaurus\\\\.org/|https://doi\\\\.org/|https://aopwiki\\\\.org/aops/|https://aopwiki\\\\.org/events/|http://www\\\\.bioassayontology\\\\.org/bao#BAO_|http://purl\\\\.obolibrary\\\\.org/obo/CHEBI_|http://purl\\\\.obolibrary\\\\.org/obo/CL_|http://www\\\\.ebi\\\\.ac\\\\.uk/efo/EFO_|http://purl\\\\.obolibrary\\\\.org/obo/GO_|http://purl\\\\.obolibrary\\\\.org/obo/IAO_|http://purl\\\\.obolibrary\\\\.org/obo/MSIO_|http://purl\\\\.obolibrary\\\\.org/obo/NCBITaxon_|http://purl\\\\.obolibrary\\\\.org/obo/NCIT_|http://purl\\\\.obolibrary\\\\.org/obo/OBI_|http://purl\\\\.obolibrary\\\\.org/obo/PATO_|http://purl\\\\.obolibrary\\\\.org/obo/UBERON_|http://purl\\\\.obolibrary\\\\.org/obo/UO_)"))
            }
        """ ;
    ] ;
    sh:or (
        # Open Researcher and Contributor: https://orcid.org/0000-0003-4423-4370
        [ rdfs:seeAlso <https://bioregistry.io/registry/orcid> ;
          sh:pattern "^https://orcid\\.org/(\\d{4}-\\d{4}-\\d{4}-\\d{3}(\\d|X))$" ]
        # Research Organization Registry: https://ror.org/03yrm5c26
        [ rdfs:seeAlso <https://bioregistry.io/registry/ror> ;
          sh:pattern "^https://ror\\.org/(0[a-hj-km-np-tv-z|0-9]{6}[0-9]{2})$" ]
        # PubChem compound: https://pubchem.ncbi.nlm.nih.gov/compound/100101
        [ rdfs:seeAlso <https://bioregistry.io/registry/pubchem.compound> ;
          sh:pattern "^https://pubchem\\.ncbi\\.nlm\\.nih\\.gov/compound/(\\d+)$" ]
        # VHP4Safety Compound Wiki: https://compoundcloud.wikibase.cloud/entity/Q2026
        [ rdfs:seeAlso <https://compoundcloud.wikibase.cloud> ;
          sh:pattern "^https://compoundcloud\\.wikibase\\.cloud/entity/(Q[0-9]+)$" ]
        # Cellosaurus: https://www.cellosaurus.org/CVCL_0440
        [ rdfs:seeAlso <https://bioregistry.io/registry/cellosaurus> ;
          sh:pattern "^https://www\\.cellosaurus\\.org/CVCL_([A-Z0-9]{4})$" ]
        # Digital Object Identifier: https://doi.org/10.1038/s41597-022-01807-3
        [ rdfs:seeAlso <https://bioregistry.io/registry/doi> ;
          sh:pattern "^https://doi\\.org/(10.\\d{2,9}/.*)$" ]
        # AOPWiki: https://aopwiki.org/aops/98
        [ rdfs:seeAlso <https://bioregistry.io/registry/aop> ;
          sh:pattern "^https://aopwiki\\.org/aops/(\\d+)$" ]
        # AOPWiki (Key Event): https://aopwiki.org/events/3
        [ rdfs:seeAlso <https://bioregistry.io/registry/aop.events> ;
          sh:pattern "^https://aopwiki\\.org/events/(\\d+)$" ]
        # BioAssay Ontology: http://www.bioassayontology.org/bao#BAO_0002989
        [ rdfs:seeAlso <https://bioregistry.io/registry/bao> ;
          sh:pattern "^http://www\\.bioassayontology\\.org/bao#BAO_(\\d{7})$" ]
        # Chemical Entities of Biological Interest: http://purl.obolibrary.org/obo/CHEBI_138488
        [ rdfs:seeAlso <https://bioregistry.io/registry/chebi> ;
          sh:pattern "^http://purl\\.obolibrary\\.org/obo/CHEBI_(\\d+)$" ]
        # Cell Ontology: http://purl.obolibrary.org/obo/CL_0000062
        [ rdfs:seeAlso <https://bioregistry.io/registry/cl> ;
          sh:pattern "^http://purl\\.obolibrary\\.org/obo/CL_(\\d{7})$" ]
        # Experimental Factor Ontology: http://www.ebi.ac.uk/efo/EFO_0005147
        [ rdfs:seeAlso <https://bioregistry.io/registry/efo> ;
          sh:pattern "^http://www\\.ebi\\.ac\\.uk/efo/EFO_(\\d{7})$" ]
        # Gene Ontology: http://purl.obolibrary.org/obo/GO_0032571
        [ rdfs:seeAlso <https://bioregistry.io/registry/go> ;
          sh:pattern "^http://purl\\.obolibrary\\.org/obo/GO_(\\d{7})$" ]
        # Information Artifact Ontology: http://purl.obolibrary.org/obo/IAO_0000030
        [ rdfs:seeAlso <https://bioregistry.io/registry/iao> ;
          sh:pattern "^http://purl\\.obolibrary\\.org/obo/IAO_(\\d{7})$" ]
        # Metabolomics Standards Initiative Ontology: http://purl.obolibrary.org/obo/MSIO_0000111
        [ rdfs:seeAlso <https://bioregistry.io/registry/msio> ;
          sh:pattern "^http://purl\\.obolibrary\\.org/obo/MSIO_(\\d{7})$" ]
        # NCBI Taxonomy: http://purl.obolibrary.org/obo/NCBITaxon_2170610
        [ rdfs:seeAlso <https://bioregistry.io/registry/ncbitaxon> ;
          sh:pattern "^http://purl\\.obolibrary\\.org/obo/NCBITaxon_((\\d+)|([a-zA-Z_]+))$" ]
        # National Cancer Institute Thesaurus: http://purl.obolibrary.org/obo/NCIT_C138986
        [ rdfs:seeAlso <https://bioregistry.io/registry/ncit> ;
          sh:pattern "^http://purl\\.obolibrary\\.org/obo/NCIT_((C|R|P|A|NHC)\\d+)$" ]
        # Ontology for Biomedical Investigations: http://purl.obolibrary.org/obo/OBI_0400109
        [ rdfs:seeAlso <https://bioregistry.io/registry/obi> ;
          sh:pattern "^http://purl\\.obolibrary\\.org/obo/OBI_(\\d{7})$" ]
        # Phenotype And Trait Ontology: http://purl.obolibrary.org/obo/PATO_0001998
        [ rdfs:seeAlso <https://bioregistry.io/registry/pato> ;
          sh:pattern "^http://purl\\.obolibrary\\.org/obo/PATO_(\\d{7})$" ]
        # Uber Anatomy Ontology: http://purl.obolibrary.org/obo/UBERON_2005080
        [ rdfs:seeAlso <https://bioregistry.io/registry/uberon> ;
          sh:pattern "^http://purl\\.obolibrary\\.org/obo/UBERON_(\\d+)$" ]
        # Units of measurement ontology: http://purl.obolibrary.org/obo/UO_0000080
        [ rdfs:seeAlso <https://bioregistry.io/registry/uo> ;
          sh:pattern "^http://purl\\.obolibrary\\.org/obo/UO_(\\d{7})$" ]
    ) ;
    sh:message "An @id in a registered identifier namespace MUST have the form its registry gives it" ;
    sh:severity sh:Violation .

# Selected: the identifier PropertyValues, by the name that states their scheme.
# Each member is one scheme: that name, and the form of its value.
tox:IdentifierValueMustBeWellFormed a sh:NodeShape ;
    sh:name "An identifier value MUST be well-formed in its scheme" ;
    sh:description "The value of a PropertyValue named after an identifier scheme MUST have the form the registry gives that scheme." ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT DISTINCT ?this WHERE {
                ?this a <http://schema.org/PropertyValue> .
                ?this <http://schema.org/name> ?name .
                FILTER(?name IN ("ORCID", "CAS", "PubChem CID", "DTXSID", "Compound Wiki", "DOI", "PubMedID"))
            }
        """ ;
    ] ;
    sh:or (
        # Open Researcher and Contributor: 0000-0003-4423-4370
        [ sh:property [ sh:path schema:name ; sh:hasValue "ORCID" ] ;
          sh:property [ sh:path schema:value ;
                        rdfs:seeAlso <https://bioregistry.io/registry/orcid> ;
                        sh:pattern "^(\\d{4}-\\d{4}-\\d{4}-\\d{3}(\\d|X))$" ] ]
        # Chemical Abstracts Service Registry Number: 50-00-0
        [ sh:property [ sh:path schema:name ; sh:hasValue "CAS" ] ;
          sh:property [ sh:path schema:value ;
                        rdfs:seeAlso <https://bioregistry.io/registry/cas> ;
                        sh:pattern "^(\\d{1,7}\\-\\d{2}\\-\\d)$" ] ]
        # PubChem compound: 100101
        [ sh:property [ sh:path schema:name ; sh:hasValue "PubChem CID" ] ;
          sh:property [ sh:path schema:value ;
                        rdfs:seeAlso <https://bioregistry.io/registry/pubchem.compound> ;
                        sh:pattern "^(\\d+)$" ] ]
        # DSSTox substance: DTXSID2021028
        [ sh:property [ sh:path schema:name ; sh:hasValue "DTXSID" ] ;
          sh:property [ sh:path schema:value ;
                        rdfs:seeAlso <https://bioregistry.io/registry/comptox> ;
                        sh:pattern "^(DTXSID\\d+)$" ] ]
        # VHP4Safety Compound Wiki: Q2026
        [ sh:property [ sh:path schema:name ; sh:hasValue "Compound Wiki" ] ;
          sh:property [ sh:path schema:value ;
                        rdfs:seeAlso <https://compoundcloud.wikibase.cloud> ;
                        sh:pattern "^(Q[0-9]+)$" ] ]
        # Digital Object Identifier: 10.1038/s41597-022-01807-3
        [ sh:property [ sh:path schema:name ; sh:hasValue "DOI" ] ;
          sh:property [ sh:path schema:value ;
                        rdfs:seeAlso <https://bioregistry.io/registry/doi> ;
                        sh:pattern "^(10.\\d{2,9}/.*)$" ] ]
        # PubMed: 16333295
        [ sh:property [ sh:path schema:name ; sh:hasValue "PubMedID" ] ;
          sh:property [ sh:path schema:value ;
                        rdfs:seeAlso <https://bioregistry.io/registry/pubmed> ;
                        sh:pattern "^(\\d+)$" ] ]
    ) ;
    sh:message "An identifier PropertyValue's schema:value MUST have the form its registry gives it" ;
    sh:severity sh:Violation .

tox:MolecularEntityInChIKeyMustBeWellFormed a sh:NodeShape ;
    sh:name "A chemical's InChIKey MUST be well-formed" ;
    sh:description "An InChIKey a chemical states MUST have the form its registry gives it." ;
    sh:targetClass bioschemas:MolecularEntity ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:inChIKey ;
        rdfs:seeAlso <https://bioregistry.io/registry/inchikey> ;
        sh:pattern "^([A-Z]{14}\\-[A-Z]{10}(\\-[A-Z])?)$" ;
        sh:message "A MolecularEntity's schema:inChIKey MUST have the form its registry gives it" ;
        sh:severity sh:Violation ;
    ] .

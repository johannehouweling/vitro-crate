# SPDX-License-Identifier: MIT
# CellLineSample — the test-system source (biological model module).
# A bioschemas:Sample typed by its sampleType: NCIT:C16403 cell line or EFO:0002660
# primary cell (#799). The additionalType labels "CellLine" and "PrimaryCell" older
# crates carry are aliases. A Sample a preparation step consumes is a test-system
# source whatever it states, so a source missing its sampleType is still caught. A cell line carries a Cellosaurus identifier;
# primary cells have none (Cellosaurus FAQ Q19) and state species and cell type.

@prefix bioschemas: <https://bioschemas.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tox: <https://w3id.org/ro/crate/isa-tox/1.0/> .
@prefix validator: <https://github.com/crs4/rocrate-validator/> .




tox:CellLineSampleMustHaveSampleType a sh:NodeShape ;
    sh:name "A test-system source Sample MUST have a sampleType" ;
    sh:description "The test-system source (cell line or primary cells) MUST be categorised via sampleType" ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?this a <https://bioschemas.org/Sample> .
                { ?this <http://schema.org/sampleType> <http://purl.obolibrary.org/obo/NCIT_C16403> }
                UNION
                { ?this <http://schema.org/sampleType> <http://www.ebi.ac.uk/efo/EFO_0002660> }
                UNION
                { ?this <http://schema.org/additionalType> "CellLine" }
                UNION
                { ?this <http://schema.org/additionalType> "PrimaryCell" }
                UNION
                { ?prep <http://schema.org/object> ?this .
                  ?prep a <https://bioschemas.org/LabProcess> .
                  { ?prep <https://bioschemas.org/properties/executesLabProtocol> ?record . ?record <https://bioschemas.org/properties/intendedUse> ?use . FILTER (?use IN (<http://www.ebi.ac.uk/efo/EFO_0003789>, <http://purl.obolibrary.org/obo/OBI_0001152>, <http://purl.obolibrary.org/obo/GO_0030154>)) }
                  UNION { ?prep <http://schema.org/additionalType> ?label . FILTER (?label IN ("TestSystemPreparation", "CellCulture")) } }
            }
        """ ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:sampleType ;
        sh:minCount 1 ;
        sh:class schema:DefinedTerm ;
        sh:message "Test-system source Sample MUST have a schema:sampleType (a DefinedTerm) categorising the test system" ;
        sh:severity sh:Violation ;
    ] .

tox:CellLineSampleShouldHaveIdentifier a sh:NodeShape ;
    sh:name "CellLineSample SHOULD have a Cellosaurus identifier" ;
    sh:description "The cell line SHOULD resolve to a Cellosaurus accession" ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE { ?this a <https://bioschemas.org/Sample> .
                { ?this <http://schema.org/sampleType> <http://purl.obolibrary.org/obo/NCIT_C16403> }
                UNION
                { ?this <http://schema.org/additionalType> "CellLine" }
            }
        """ ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:identifier ;
        sh:minCount 1 ;
        sh:message "Cell-line Sample SHOULD have a schema:identifier resolving to a Cellosaurus accession (CVCL_...)" ;
        sh:severity sh:Warning ;
    ] .

tox:PrimaryCellSampleShouldDescribeSource a sh:NodeShape ;
    sh:name "PrimaryCellSample SHOULD state its species and cell type" ;
    sh:description "Primary cells have no Cellosaurus record, so the source is described by the species and the cell type it was isolated as" ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE { ?this a <https://bioschemas.org/Sample> .
                { ?this <http://schema.org/sampleType> <http://www.ebi.ac.uk/efo/EFO_0002660> }
                UNION
                { ?this <http://schema.org/additionalType> "PrimaryCell" }
            }
        """ ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:taxonomicRange ;
        sh:minCount 1 ;
        sh:message "Primary-cell Sample SHOULD state the species its cells come from (schema:taxonomicRange)" ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:additionalProperty ;
        sh:qualifiedValueShape [
            sh:property [ sh:path schema:propertyID ; sh:hasValue <http://www.ebi.ac.uk/efo/EFO_0000324> ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Primary-cell Sample SHOULD state its cell type as a characteristic (schema:additionalProperty with propertyID EFO:0000324)" ;
        sh:severity sh:Warning ;
    ] .

# The sample types ISA-Tox knows (#799); a warning first.
#
# The list covers the kinds of test system an in vitro study uses, not only the
# two this profile places extra requirements on (#856): a cell line and primary
# cells carry their own shapes, while an organoid, a tissue, an organ fragment or
# a whole organism are recognised and constrained no further. Before #856 those
# warned, so a crate describing an organoid was told its correct sampleType was
# unknown. A kind with no term here (a sub-cellular fraction, say) still warns —
# add its term rather than widening this to anything resolvable, which would stop
# catching the typo this shape exists for.
tox:SampleTypeIsKnown a sh:NodeShape ;
    sh:name "A Sample's sampleType SHOULD be an ISA-Tox sample type" ;
    sh:description "A sampleType SHOULD be one of the ISA-Tox sample types" ;
    sh:targetSubjectsOf schema:sampleType ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:sampleType ;
        sh:in (
            <http://purl.obolibrary.org/obo/NCIT_C16403>
            <http://www.ebi.ac.uk/efo/EFO_0002660>
            <http://purl.obolibrary.org/obo/NCIT_C93168>
            <http://purl.obolibrary.org/obo/OBI_0001876>
            <http://purl.obolibrary.org/obo/NCIT_C172259>
            <http://purl.obolibrary.org/obo/UBERON_0000479>
            <http://purl.obolibrary.org/obo/UBERON_0000064>
            <http://purl.obolibrary.org/obo/UBERON_0000468>
        ) ;
        sh:message "A Sample's sampleType SHOULD be one of the ISA-Tox sample types: cell line, primary cell, co-culture, cell culture, organoid, tissue, organ part or multicellular organism" ;
        sh:severity sh:Warning ;
    ] .

# SPDX-License-Identifier: MIT
# CellLineSample — the test-system source (biological model module).
# A bioschemas:Sample typed by its sampleType: NCIT:C16403 cell line or EFO:0002660
# primary cell (#799). The additionalType labels "CellLine" and "PrimaryCell" older
# crates carry are aliases. A Sample a preparation step consumes is a test-system
# source whatever it states, so a source missing its sampleType is still caught. A cell line carries a Cellosaurus identifier;
# primary cells have none (Cellosaurus FAQ Q19) and state species and cell type.

@prefix bioschemas: <https://bioschemas.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tox: <https://w3id.org/ro/crate/isa-tox/1.0/> .
@prefix validator: <https://github.com/crs4/rocrate-validator/> .

# Inference: type a Sample as tox:CellLineSample when additionalType == "CellLine".
tox:FindCellLineSamples a sh:NodeShape, validator:HiddenShape ;
    sh:name "Identify cell-line samples within the RO-Crate" ;
    sh:description "A Sample with additionalType 'CellLine' is the cell-based test system." ;
    sh:targetClass bioschemas:Sample ;
    sh:order 10 ;
    sh:rule [
        a sh:TripleRule ;
        sh:subject sh:this ;
        sh:predicate rdf:type ;
        sh:object tox:CellLineSample ;
        sh:condition [
            a sh:NodeShape ;
            sh:property [
                sh:path schema:additionalType ;
                sh:hasValue "CellLine" ;
                sh:minCount 1 ;
            ] ;
        ] ;
    ] ;
    sh:rule [
        a sh:TripleRule ;
        sh:subject sh:this ;
        sh:predicate rdf:type ;
        sh:object tox:CellLineSample ;
        sh:condition [
            a sh:NodeShape ;
            sh:property [ sh:path schema:sampleType ; sh:hasValue <http://purl.obolibrary.org/obo/NCIT_C16403> ; sh:minCount 1 ] ;
        ] ;
    ] .

# Inference: type a Sample as tox:PrimaryCellSample when additionalType == "PrimaryCell".
tox:FindPrimaryCellSamples a sh:NodeShape, validator:HiddenShape ;
    sh:name "Identify primary-cell samples within the RO-Crate" ;
    sh:description "A Sample with additionalType 'PrimaryCell' is a test-system source of primary cells." ;
    sh:targetClass bioschemas:Sample ;
    sh:order 10 ;
    sh:rule [
        a sh:TripleRule ;
        sh:subject sh:this ;
        sh:predicate rdf:type ;
        sh:object tox:PrimaryCellSample ;
        sh:condition [
            a sh:NodeShape ;
            sh:property [
                sh:path schema:additionalType ;
                sh:hasValue "PrimaryCell" ;
                sh:minCount 1 ;
            ] ;
        ] ;
    ] ;
    sh:rule [
        a sh:TripleRule ;
        sh:subject sh:this ;
        sh:predicate rdf:type ;
        sh:object tox:PrimaryCellSample ;
        sh:condition [
            a sh:NodeShape ;
            sh:property [ sh:path schema:sampleType ; sh:hasValue <http://www.ebi.ac.uk/efo/EFO_0002660> ; sh:minCount 1 ] ;
        ] ;
    ] .

# Inference: a Sample a test system preparation consumes is a test-system source.
# Ordered after the process rules (11), which type the preparation step.
tox:FindTestSystemSources a sh:NodeShape, validator:HiddenShape ;
    sh:name "Identify test-system sources within the RO-Crate" ;
    sh:description "A Sample a test system preparation consumes is the test-system source." ;
    sh:targetClass bioschemas:Sample ;
    sh:order 12 ;
    sh:rule [
        a sh:TripleRule ;
        sh:subject sh:this ;
        sh:predicate rdf:type ;
        sh:object tox:TestSystemSource ;
        sh:condition [
            a sh:NodeShape ;
            sh:property [
                sh:path [ sh:inversePath schema:object ] ;
                sh:qualifiedValueShape [ sh:class tox:LabProcessTestSystemPreparation ] ;
                sh:qualifiedMinCount 1 ;
            ] ;
        ] ;
    ] .

tox:CellLineSampleMustHaveSampleType a sh:NodeShape ;
    sh:name "A test-system source Sample MUST have a sampleType" ;
    sh:description "The test-system source (cell line or primary cells) MUST be categorised via sampleType" ;
    sh:targetClass tox:CellLineSample ;
    sh:targetClass tox:PrimaryCellSample ;
    sh:targetClass tox:TestSystemSource ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:sampleType ;
        sh:minCount 1 ;
        sh:class schema:DefinedTerm ;
        sh:message "Test-system source Sample MUST have a schema:sampleType (a DefinedTerm) categorising the test system" ;
        sh:severity sh:Violation ;
    ] .

tox:CellLineSampleShouldHaveIdentifier a sh:NodeShape ;
    sh:name "CellLineSample SHOULD have a Cellosaurus identifier" ;
    sh:description "The cell line SHOULD resolve to a Cellosaurus accession" ;
    sh:targetClass tox:CellLineSample ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:identifier ;
        sh:minCount 1 ;
        sh:message "Cell-line Sample SHOULD have a schema:identifier resolving to a Cellosaurus accession (CVCL_...)" ;
        sh:severity sh:Warning ;
    ] .

tox:PrimaryCellSampleShouldDescribeSource a sh:NodeShape ;
    sh:name "PrimaryCellSample SHOULD state its species and cell type" ;
    sh:description "Primary cells have no Cellosaurus record, so the source is described by the species and the cell type it was isolated as" ;
    sh:targetClass tox:PrimaryCellSample ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:taxonomicRange ;
        sh:minCount 1 ;
        sh:message "Primary-cell Sample SHOULD state the species its cells come from (schema:taxonomicRange)" ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:additionalProperty ;
        sh:qualifiedValueShape [
            sh:property [ sh:path schema:propertyID ; sh:hasValue <http://www.ebi.ac.uk/efo/EFO_0000324> ]
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Primary-cell Sample SHOULD state its cell type as a characteristic (schema:additionalProperty with propertyID EFO:0000324)" ;
        sh:severity sh:Warning ;
    ] .

# The sample types ISA-Tox knows (#799); a warning first.
tox:SampleTypeIsKnown a sh:NodeShape ;
    sh:name "A Sample's sampleType SHOULD be an ISA-Tox sample type" ;
    sh:description "A sampleType SHOULD be one of the ISA-Tox sample types" ;
    sh:targetSubjectsOf schema:sampleType ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:sampleType ;
        sh:in (
            <http://purl.obolibrary.org/obo/NCIT_C16403>
            <http://www.ebi.ac.uk/efo/EFO_0002660>
            <http://purl.obolibrary.org/obo/NCIT_C93168>
            <http://purl.obolibrary.org/obo/OBI_0001876>
        ) ;
        sh:message "A Sample's sampleType SHOULD be one of the ISA-Tox sample types: cell line, primary cell, co-culture or cell culture" ;
        sh:severity sh:Warning ;
    ] .

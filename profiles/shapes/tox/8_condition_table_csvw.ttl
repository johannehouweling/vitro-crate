# SPDX-License-Identifier: MIT
# Condition table: the exposure's per-well design, typed as CSV on the Web.
# Each column carries a datatype and an ontology propertyUrl, so the table is
# machine-actionable.

@prefix csvw: <http://www.w3.org/ns/csvw#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tox: <https://w3id.org/ro/crate/isa-tox/1.0/> .

# The table is the registry of the exposed units, one row per well. Nested, so the
# finding names schema:result rather than a blank node.
tox:ExposureShouldHaveCsvwConditionTable a sh:NodeShape ;
    sh:name "An exposure SHOULD have a CSVW condition table" ;
    sh:description "The exposed test system SHOULD be described by a CSVW-typed condition table." ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?this a <https://bioschemas.org/LabProcess> .
                { ?this <https://bioschemas.org/properties/executesLabProtocol> ?record .
                  ?record <https://bioschemas.org/properties/intendedUse> <http://www.ebi.ac.uk/efo/EFO_0003969> }
                UNION
                { ?this <http://schema.org/additionalType> "Exposure" }
            }
        """ ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:result ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path [ sh:inversePath schema:about ] ;
                sh:qualifiedValueShape [ sh:class csvw:Table ] ;
                sh:qualifiedMinCount 1 ;
            ] ;
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Exposure SHOULD have a CSVW-typed condition table (csvw:Table) about its result" ;
        sh:severity sh:Warning ;
    ] .

tox:CsvwTableShouldHaveSchema a sh:NodeShape ;
    sh:name "A CSVW table SHOULD declare a table schema" ;
    sh:description "A CSVW data table SHOULD declare a csvw:tableSchema typing its columns." ;
    sh:targetClass csvw:Table ;
    sh:property [
        a sh:PropertyShape ;
        sh:path csvw:tableSchema ;
        sh:minCount 1 ;
        sh:message "A CSVW data table SHOULD declare a csvw:tableSchema typing its columns" ;
        sh:severity sh:Warning ;
    ] .

tox:CsvwColumnShouldBeTyped a sh:NodeShape ;
    sh:name "A CSVW column SHOULD be typed and mapped to a term" ;
    sh:description "A CSVW column SHOULD declare a datatype and a propertyUrl naming an ontology term." ;
    sh:targetClass csvw:Column ;
    sh:property [
        a sh:PropertyShape ;
        sh:path csvw:datatype ;
        sh:minCount 1 ;
        sh:message "CSVW column SHOULD declare a csvw:datatype" ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path csvw:propertyUrl ;
        sh:minCount 1 ;
        sh:message "CSVW column SHOULD declare a csvw:propertyUrl mapping it to an ontology term" ;
        sh:severity sh:Warning ;
    ] .

# SPDX-License-Identifier: MIT
# LabProcess - Data Analysis: derives the reported results from the raw measurements.
# A LabProcess whose protocol record's intendedUse is OBI:0200000 data transformation;
# the additionalType label "DataAnalysis" is read as an alias.

@prefix bioschemas: <https://bioschemas.org/> .
@prefix bioschemas-prop: <https://bioschemas.org/properties/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tox: <https://w3id.org/ro/crate/isa-tox/1.0/> .
@prefix validator: <https://github.com/crs4/rocrate-validator/> .


tox:DataAnalysisRequirements a sh:NodeShape ;
    sh:name "A data analysis MUST state its input, result and parameters" ;
    sh:description "A data analysis MUST declare the data it consumes, the processed data it produces and its parameters." ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?this a <https://bioschemas.org/LabProcess> .
                { ?this <https://bioschemas.org/properties/executesLabProtocol> ?record .
                  ?record <https://bioschemas.org/properties/intendedUse> <http://purl.obolibrary.org/obo/OBI_0200000> }
                UNION
                { ?this <http://schema.org/additionalType> "DataAnalysis" }
            }
        """ ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:object ;
        sh:minCount 1 ;
        sh:message "DataAnalysis process MUST have at least one schema:object (the raw/condition data being analysed)" ;
        sh:severity sh:Violation ;
    ] ;
    # The input SHOULD be data, not a Sample. A warning rather than a violation:
    # crates deposited before this check would otherwise stop conforming. Promote
    # it once those deposits have been rebuilt.
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:object ;
        sh:class schema:MediaObject ;
        sh:message "DataAnalysis schema:object SHOULD be the data analysed (a File), not a Sample" ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:result ;
        sh:minCount 1 ;
        sh:message "DataAnalysis process MUST have at least one schema:result (processed-data output File)" ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:additionalProperty ;
        sh:minCount 1 ;
        sh:message "DataAnalysis process MUST have at least one schema:additionalProperty (e.g. Computational Tool, Data Calculation and Statistics)" ;
        sh:severity sh:Violation ;
    ] .

# The analysis SHOULD follow a deposited script: its protocol record is based on the
# script, because the script is the procedure the step follows. A warning rather
# than a violation: an analysis done by hand in a spreadsheet deposits no
# re-runnable step, which is an action point rather than non-conformance.
tox:DataAnalysisShouldFollowAnalysisScript a sh:NodeShape ;
    sh:name "A data analysis SHOULD follow a deposited script" ;
    sh:description "A data analysis SHOULD execute a protocol record based on the analysis script it ran." ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?this a <https://bioschemas.org/LabProcess> .
                { ?this <https://bioschemas.org/properties/executesLabProtocol> ?record .
                  ?record <https://bioschemas.org/properties/intendedUse> <http://purl.obolibrary.org/obo/OBI_0200000> }
                UNION
                { ?this <http://schema.org/additionalType> "DataAnalysis" }
            }
        """ ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path bioschemas-prop:executesLabProtocol ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path schema:isBasedOn ;
                sh:qualifiedValueShape [ sh:class schema:SoftwareSourceCode ] ;
                sh:qualifiedMinCount 1 ;
            ] ;
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "DataAnalysis SHOULD execute a protocol (bioschemas:executesLabProtocol) based on a deposited analysis script (schema:SoftwareSourceCode)" ;
        sh:severity sh:Warning ;
    ] .

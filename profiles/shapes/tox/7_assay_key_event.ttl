# SPDX-License-Identifier: MIT
# Assay - Key Event: the Key Event the assay's endpoint reads out.
# An Assay SHOULD mention the Key Event it measures by its AOP-Wiki IRI, https://aopwiki.org/events/<id>.
# An Assay is selected as the ISA profile defines one: a Dataset whose additionalType
# is "Assay".

@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tox: <https://w3id.org/ro/crate/isa-tox/1.0/> .

tox:AssayShouldReferenceKeyEvent a sh:NodeShape ;
    sh:name "An assay SHOULD reference the Key Event it measures" ;
    sh:description "An Assay SHOULD reference the AOP-Wiki Key Event its endpoint reads out." ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?this <http://schema.org/additionalType> "Assay" .
                ?this a <http://schema.org/Dataset> .
            }
        """ ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:mentions ;
        sh:qualifiedValueShape [ sh:nodeKind sh:IRI ; sh:pattern "^https://aopwiki\\.org/events/[0-9]+$" ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Assay SHOULD reference the Key Event its endpoint reads out via schema:mentions, as its AOP-Wiki IRI https://aopwiki.org/events/<id>" ;
        sh:severity sh:Warning ;
    ] .

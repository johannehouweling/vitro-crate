# ISA Tox RO-Crate Profile - SHACL Shapes (SHOULD / RECOMMENDED)
# Toxicology extension of the ISA RO-Crate Profile, version 0.1-draft

@prefix bioschemas: <https://bioschemas.org/> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tox: <https://w3id.org/ro/crate/isa-tox/1.0/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tox:LabProcessEndpointReadoutShape
    a sh:NodeShape ;
    sh:name "LabProcessEndpointReadout" ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select "SELECT DISTINCT ?this WHERE { ?this <http://schema.org/additionalType> \"EndpointReadout\" . }" ;
    ] ;
    sh:property [
        sh:path schema:object ;
        sh:or ( [ sh:class bioschemas:Sample ] [ sh:class schema:MediaObject ] ) ;
        sh:message "Add schema:object linking to bioschemas:Sample or schema:MediaObject input entities being measured" ;
    ] ;
    sh:property [
        sh:path bioschemas:executesLabProtocol ;
        sh:class bioschemas:LabProtocol ;
        sh:message "Add bioschemas:executesLabProtocol linking to the bioschemas:LabProtocol this readout executes" ;
    ] .

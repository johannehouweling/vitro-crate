# SPDX-License-Identifier: MIT
# MolecularEntity - Test and Control Chemicals: name and chemical identity.
# Chemicals are selected by their type, bioschemas:MolecularEntity.

@prefix bioschemas: <https://bioschemas.org/> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tox: <https://w3id.org/ro/crate/isa-tox/1.0/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tox:MolecularEntityMustHaveName a sh:NodeShape ;
    sh:name "A test or control chemical MUST have a name" ;
    sh:description "A test or control chemical MUST carry a name." ;
    sh:targetClass bioschemas:MolecularEntity ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:not [ sh:hasValue "" ] ;
        sh:message "MolecularEntity (test/control compound) MUST have a non-empty schema:name" ;
        sh:severity sh:Violation ;
    ] .

tox:MolecularEntityShouldHaveIdentity a sh:NodeShape ;
    sh:name "A test or control chemical SHOULD carry its chemical identity" ;
    sh:description "A test or control chemical SHOULD carry an identifier resolving to an authoritative record, and its structure." ;
    sh:targetClass bioschemas:MolecularEntity ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:identifier ;
        sh:minCount 1 ;
        sh:message "MolecularEntity SHOULD have a schema:identifier (InChIKey, CAS, PubChem CID, CompoundWiki Q id, ...) resolving the compound" ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:inChIKey ;
        sh:minCount 1 ;
        sh:message "MolecularEntity SHOULD have a schema:inChIKey for unambiguous structure lookup" ;
        sh:severity sh:Warning ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:smiles ;
        sh:minCount 1 ;
        sh:message "MolecularEntity SHOULD have a schema:smiles structure string" ;
        sh:severity sh:Warning ;
    ] .

# SPDX-License-Identifier: MIT
# LabProcess - Endpoint Readout: measures the assay endpoint.
# A LabProcess whose protocol record's intendedUse is BAO:0000523 assay protocol;
# the additionalType label "EndpointReadout" is read as an alias. It measures the
# exposed test system, or a deposited File in a re-analysis, and produces the raw
# measurement File(s).

@prefix bioschemas: <https://bioschemas.org/> .
@prefix bioschemas-prop: <https://bioschemas.org/properties/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tox: <https://w3id.org/ro/crate/isa-tox/1.0/> .
@prefix validator: <https://github.com/crs4/rocrate-validator/> .


tox:EndpointReadoutRequirements a sh:NodeShape ;
    sh:name "An endpoint readout MUST state its result and parameters" ;
    sh:description "An endpoint readout MUST declare the measurement File it produces and its parameters." ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?this a <https://bioschemas.org/LabProcess> .
                { ?this <https://bioschemas.org/properties/executesLabProtocol> ?record .
                  ?record <https://bioschemas.org/properties/intendedUse> <http://www.bioassayontology.org/bao#BAO_0000523> }
                UNION
                { ?this <http://schema.org/additionalType> "EndpointReadout" }
            }
        """ ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:result ;
        sh:minCount 1 ;
        sh:message "EndpointReadout process MUST have at least one schema:result (output measurement File)" ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:additionalProperty ;
        sh:minCount 1 ;
        sh:message "EndpointReadout process MUST have at least one schema:additionalProperty (e.g. Detection Instrument, Endpoint, Measured Entity)" ;
        sh:severity sh:Violation ;
    ] .

# What the readout measured, a File or a Sample: a readout measures exposed cells,
# a re-analysis measures deposited data. That the input is an exposure's result is
# not asserted here: a characterisation run legitimately measures the culture, and
# the condition spans two entities.
tox:EndpointReadoutConsumesExposedMaterial a sh:NodeShape ;
    sh:name "An endpoint readout MUST state what it measured" ;
    sh:description "An endpoint readout MUST declare the material or data it measured." ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?this a <https://bioschemas.org/LabProcess> .
                { ?this <https://bioschemas.org/properties/executesLabProtocol> ?record .
                  ?record <https://bioschemas.org/properties/intendedUse> <http://www.bioassayontology.org/bao#BAO_0000523> }
                UNION
                { ?this <http://schema.org/additionalType> "EndpointReadout" }
            }
        """ ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:object ;
        sh:minCount 1 ;
        sh:or (
            [ sh:class schema:MediaObject ]
            [ sh:class bioschemas:Sample ]
        ) ;
        sh:message "EndpointReadout process MUST have at least one schema:object naming what it measured: the exposed Sample, or the File it re-analysed" ;
        sh:severity sh:Violation ;
    ] .

# SPDX-License-Identifier: MIT
# Identifier PropertyValue: a PubMed ID names its scheme.
# A PropertyValue named "PubMedID" MUST set its propertyID to the OBI PubMed
# identifier term.

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tox: <https://w3id.org/ro/crate/isa-tox/1.0/> .
@prefix validator: <https://github.com/crs4/rocrate-validator/> .


tox:PubMedIDPropertyValueMustHaveOBIPropertyID a sh:NodeShape ;
    sh:name "A PubMed ID MUST name its identifier scheme" ;
    sh:description "A PropertyValue named PubMedID MUST set its propertyID to OBI:0001617." ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE { ?this a <http://schema.org/PropertyValue> . ?this <http://schema.org/name> "PubMedID" }
        """ ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:propertyID ;
        sh:minCount 1 ;
        sh:hasValue <http://purl.obolibrary.org/obo/OBI_0001617> ;
        sh:message "A PubMedID PropertyValue MUST set schema:propertyID to OBI:0001617 (PubMed identifier)" ;
        sh:severity sh:Violation ;
    ] .

# SPDX-License-Identifier: MIT
# LabProcess - Exposure: exposes the test system to one or more chemicals.
# A LabProcess whose protocol record's intendedUse is EFO:0003969 treatment protocol;
# the additionalType label "Exposure" is read as an alias. It consumes the test
# system and produces the exposed test system.
#
# The compounds are the reagents of the protocol record the step executes: ISA
# restricts schema:object to File, Sample and BioSample, so a MolecularEntity cannot
# be the step's input. The per-well condition table is a data file about the exposed
# Samples (8_condition_table_csvw.ttl).

@prefix bioschemas: <https://bioschemas.org/> .
@prefix bioschemas-prop: <https://bioschemas.org/properties/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tox: <https://w3id.org/ro/crate/isa-tox/1.0/> .
@prefix validator: <https://github.com/crs4/rocrate-validator/> .


tox:ExposureRequirements a sh:NodeShape ;
    sh:name "An exposure MUST state its input, result, parameters and compounds" ;
    sh:description "An exposure MUST declare the test system it consumes, the exposed test system it produces, its parameters and the compounds it applied." ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?this a <https://bioschemas.org/LabProcess> .
                { ?this <https://bioschemas.org/properties/executesLabProtocol> ?record .
                  ?record <https://bioschemas.org/properties/intendedUse> <http://www.ebi.ac.uk/efo/EFO_0003969> }
                UNION
                { ?this <http://schema.org/additionalType> "Exposure" }
            }
        """ ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:object ;
        sh:minCount 1 ;
        sh:message "Exposure process MUST have at least one schema:object (the cultured cell Sample being exposed)" ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:result ;
        sh:minCount 1 ;
        sh:message "Exposure process MUST have at least one schema:result (the exposed Sample)" ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:additionalProperty ;
        sh:minCount 1 ;
        sh:message "Exposure process MUST have at least one schema:additionalProperty (e.g. Exposure Duration, Cell Seeding Density)" ;
        sh:severity sh:Violation ;
    ] ;
    # Nested rather than a sequence path, so the finding names executesLabProtocol
    # rather than a blank node.
    sh:property [
        a sh:PropertyShape ;
        sh:path bioschemas-prop:executesLabProtocol ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path bioschemas-prop:reagent ;
                sh:qualifiedValueShape [ sh:class bioschemas:MolecularEntity ] ;
                sh:qualifiedMinCount 1 ;
            ] ;
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Exposure process MUST execute a protocol (bioschemas:executesLabProtocol) whose reagents include at least one test or control compound (MolecularEntity)" ;
        sh:severity sh:Violation ;
    ] .

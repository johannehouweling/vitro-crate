# SPDX-License-Identifier: MIT
# LabProcessExposure — exposure process (exposure module).
# A bioschemas:LabProcess whose protocol record's intendedUse is EFO:0003969 treatment
# protocol (#799); the additionalType label "Exposure" older crates carry is an alias. Takes the
# cultured cell Sample as input and emits the EXPOSED Sample as its result.
#
# The compounds are the reagents of the protocol record the Exposure executes: ISA
# restricts schema:object to File/Sample/BioSample, so a MolecularEntity cannot be
# the process input (#783). The per-well condition table is a data file about the
# exposed Samples (8_condition_table_csvw.ttl).

@prefix bioschemas: <https://bioschemas.org/> .
@prefix bioschemas-prop: <https://bioschemas.org/properties/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tox: <https://w3id.org/ro/crate/isa-tox/1.0/> .
@prefix validator: <https://github.com/crs4/rocrate-validator/> .

tox:FindExposureProcesses a sh:NodeShape, validator:HiddenShape ;
    sh:name "Identify exposure processes" ;
    sh:targetClass bioschemas:LabProcess ;
    sh:order 11 ;
    sh:rule [
        a sh:TripleRule ;
        sh:subject sh:this ;
        sh:predicate rdf:type ;
        sh:object tox:LabProcessExposure ;
        sh:condition [
            a sh:NodeShape ;
            sh:property [ sh:path schema:additionalType ; sh:hasValue "Exposure" ; sh:minCount 1 ] ;
        ] ;
    ] ;
    sh:rule [
        a sh:TripleRule ;
        sh:subject sh:this ;
        sh:predicate rdf:type ;
        sh:object tox:LabProcessExposure ;
        sh:condition [
            a sh:NodeShape ;
            sh:property [
                sh:path ( bioschemas-prop:executesLabProtocol bioschemas-prop:intendedUse ) ;
                sh:hasValue <http://www.ebi.ac.uk/efo/EFO_0003969> ;
                sh:minCount 1 ;
            ] ;
        ] ;
    ] .

tox:ExposureRequirements a sh:NodeShape ;
    sh:name "Exposure process requirements" ;
    sh:description "An exposure process MUST declare its input cells, exposed-sample result, parameters, and the compounds it applied" ;
    sh:targetClass tox:LabProcessExposure ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:object ;
        sh:minCount 1 ;
        sh:message "Exposure process MUST have at least one schema:object (the cultured cell Sample being exposed)" ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:result ;
        sh:minCount 1 ;
        sh:message "Exposure process MUST have at least one schema:result (the exposed Sample)" ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:additionalProperty ;
        sh:minCount 1 ;
        sh:message "Exposure process MUST have at least one schema:additionalProperty (e.g. Exposure Duration, Cell Seeding Density)" ;
        sh:severity sh:Violation ;
    ] ;
    # It is not toxicology if nothing was exposed to a chemical. Nested rather than
    # a sequence path, so the finding names executesLabProtocol, not a blank node.
    sh:property [
        a sh:PropertyShape ;
        sh:path bioschemas-prop:executesLabProtocol ;
        sh:qualifiedValueShape [
            sh:property [
                sh:path bioschemas-prop:reagent ;
                sh:qualifiedValueShape [ sh:class bioschemas:MolecularEntity ] ;
                sh:qualifiedMinCount 1 ;
            ] ;
        ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Exposure process MUST execute a protocol (bioschemas:executesLabProtocol) whose reagents include at least one test or control compound (MolecularEntity)" ;
        sh:severity sh:Violation ;
    ] .

# SPDX-License-Identifier: MIT
# Sample - Test System and Co-Culture: how many Samples a test system derives from.
#
# A test system grown from several sources is a co-culture and must say so; a
# culture of one source derives from that source. Both directions are checked, so
# the co-culture type cannot be used to escape the first rule.
#
#   OBI:0001876  cell culture  ->  one parent Sample
#   NCIT:C93168  co-culture    ->  two or more
#
# The path is schema:isBasedOn: derivesFrom is the compact term crates write, and
# the context maps it there. OBI:0001876 also covers the exposed test system: an
# exposure changes a sample's state, not its kind, and one exposed sample derives
# from one cultured one.

@prefix bioschemas: <https://bioschemas.org/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tox: <https://w3id.org/ro/crate/isa-tox/1.0/> .
@prefix validator: <https://github.com/crs4/rocrate-validator/> .


tox:CulturedSampleDerivesFromOneLine a sh:NodeShape ;
    sh:name "A cell culture MUST derive from at most one Sample" ;
    sh:description "Sources cultured separately yield one Sample each; one Sample grown from several sources is a co-culture." ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE { ?this a <https://bioschemas.org/Sample> . ?this <http://schema.org/sampleType> <http://purl.obolibrary.org/obo/OBI_0001876> }
        """ ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:isBasedOn ;
        sh:maxCount 1 ;
        sh:message "A cultured Sample MUST derive (schema:isBasedOn) from at most one parent Sample. Culture each source separately, or type the material as a co-culture (NCIT:C93168)" ;
        sh:severity sh:Violation ;
    ] .

# A warning rather than a violation: the material is still described, and a
# depositor who cannot say where a culture came from should not be blocked, but an
# unstated source is a gap in its provenance.
tox:CulturedSampleShouldStateItsSource a sh:NodeShape ;
    sh:name "A cell culture SHOULD state the Sample it was grown from" ;
    sh:description "The derivation chain from the exposed test system to the source cells requires each cultured Sample to state its parent." ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE { ?this a <https://bioschemas.org/Sample> . ?this <http://schema.org/sampleType> <http://purl.obolibrary.org/obo/OBI_0001876> }
        """ ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:isBasedOn ;
        sh:minCount 1 ;
        sh:message "A cultured Sample SHOULD state the Sample it was grown from (schema:isBasedOn)" ;
        sh:severity sh:Warning ;
    ] .

tox:CoCultureDerivesFromSeveralLines a sh:NodeShape ;
    sh:name "A co-culture MUST derive from two or more Samples" ;
    sh:description "A co-culture is a mixture; a single source grown alone is a cell culture." ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE { ?this a <https://bioschemas.org/Sample> . ?this <http://schema.org/sampleType> <http://purl.obolibrary.org/obo/NCIT_C93168> }
        """ ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:isBasedOn ;
        sh:minCount 2 ;
        sh:message "A Sample typed as a co-culture (NCIT:C93168) MUST derive (schema:isBasedOn) from two or more parent Samples. One source grown alone is a cell culture (OBI:0001876)" ;
        sh:severity sh:Violation ;
    ] .

# SPDX-License-Identifier: MIT
# ISA-Tox RO-Crate Profile: profile descriptor.
#
# The toxicology (in vitro NAM) domain layer: an extension of the ISA RO-Crate
# profile (bundled in roc-validator as `isa-ro-crate`), which extends RO-Crate 1.1.
# Validating against `tox-ro-crate` runs the isa-ro-crate and ro-crate checks too.
#
# The `isTransitiveProfileOf .../crate/1.1` below mirrors the upstream isa-ro-crate
# profile, which declares itself a profile of RO-Crate 1.1. Crates that declare
# RO-Crate 1.2 still validate against the 1.2 base, which is backward compatible.
# Change this to 1.2 only when the upstream profile does; a test keeps the two in
# sync.

@prefix dct: <http://purl.org/dc/terms/> .
@prefix prof: <http://www.w3.org/ns/dx/prof/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/ro/crate/isa-tox/1.0>
    a prof:Profile ;
    rdfs:label "ISA-Tox RO-Crate Profile" ;
    # The /1.0 IRI names the series; this is its exact version, kept in step with
    # the specification's header and the Profile Crate.
    dct:hasVersion "1.0.0" ;
    rdfs:comment "Toxicology (in vitro New Approach Methodology) domain extension of the ISA RO-Crate Profile."@en ;

    # Extends the bundled ISA RO-Crate profile (token `isa-ro-crate`), which extends
    # RO-Crate 1.1.
    prof:isProfileOf <https://github.com/nfdi4plants/isa-ro-crate-profile> ;
    prof:isTransitiveProfileOf
        <https://github.com/nfdi4plants/isa-ro-crate-profile> ,
        <https://w3id.org/ro/crate/1.1> ;

    prof:hasToken "tox-ro-crate" ;
.

# SPDX-License-Identifier: MIT
# Study - Adverse Outcome Pathway: the pathway the study addresses.
# A Study SHOULD mention its pathway by its AOP-Wiki IRI, https://aopwiki.org/aops/<id>.
# A Study is selected as the ISA profile defines one: a Dataset whose additionalType
# is "Study".

@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tox: <https://w3id.org/ro/crate/isa-tox/1.0/> .

tox:StudyShouldReferenceAOP a sh:NodeShape ;
    sh:name "A study SHOULD reference its Adverse Outcome Pathway" ;
    sh:description "A Study SHOULD reference the AOP-Wiki Adverse Outcome Pathway it addresses." ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?this <http://schema.org/additionalType> "Study" .
                ?this a <http://schema.org/Dataset> .
            }
        """ ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:mentions ;
        sh:qualifiedValueShape [ sh:nodeKind sh:IRI ; sh:pattern "^https://aopwiki\\.org/aops/[0-9]+$" ] ;
        sh:qualifiedMinCount 1 ;
        sh:message "Study SHOULD reference its Adverse Outcome Pathway via schema:mentions, as its AOP-Wiki IRI https://aopwiki.org/aops/<id>" ;
        sh:severity sh:Warning ;
    ] .

# SPDX-License-Identifier: MIT
# LabProcessTestSystemPreparation — test system preparation (biological model preparation).
# A bioschemas:LabProcess whose protocol record's intendedUse is a term of the ISA-Tox
# three terms this profile recognises for it (growth protocol, transfection,
# cell differentiation), reused from EFO, OBI and GO.
# Older crates are read by aliases: the additionalType labels "TestSystemPreparation"
# and "CellCulture", and growth protocol or transfection stated without the set (#799).

@prefix bioschemas: <https://bioschemas.org/> .
@prefix bioschemas-prop: <https://bioschemas.org/properties/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tox: <https://w3id.org/ro/crate/isa-tox/1.0/> .
@prefix validator: <https://github.com/crs4/rocrate-validator/> .


tox:TestSystemPreparationRequirements a sh:NodeShape ;
    sh:name "TestSystemPreparation process requirements" ;
    sh:description "A test system preparation process MUST declare its input cells, output cultured sample, and parameters" ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            SELECT ?this WHERE {
                ?this a <https://bioschemas.org/LabProcess> .
                { ?this <https://bioschemas.org/properties/executesLabProtocol> ?record .
                  ?record <https://bioschemas.org/properties/intendedUse> <http://www.ebi.ac.uk/efo/EFO_0003789> }
                UNION
                { ?this <https://bioschemas.org/properties/executesLabProtocol> ?record .
                  ?record <https://bioschemas.org/properties/intendedUse> <http://purl.obolibrary.org/obo/OBI_0001152> }
                UNION
                { ?this <https://bioschemas.org/properties/executesLabProtocol> ?record .
                  ?record <https://bioschemas.org/properties/intendedUse> <http://purl.obolibrary.org/obo/GO_0030154> }
                UNION
                { ?this <http://schema.org/additionalType> "TestSystemPreparation" }
                UNION
                { ?this <http://schema.org/additionalType> "CellCulture" }
            }
        """ ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:object ;
        sh:minCount 1 ;
        sh:message "TestSystemPreparation process MUST have at least one schema:object (input source Sample: a cell line or primary cells)" ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:result ;
        sh:minCount 1 ;
        sh:message "TestSystemPreparation process MUST have at least one schema:result (output cultured Sample)" ;
        sh:severity sh:Violation ;
    ] ;
    sh:property [
        a sh:PropertyShape ;
        sh:path schema:additionalProperty ;
        sh:minCount 1 ;
        sh:message "TestSystemPreparation process MUST have at least one schema:additionalProperty (e.g. Culture Medium)" ;
        sh:severity sh:Violation ;
    ] .

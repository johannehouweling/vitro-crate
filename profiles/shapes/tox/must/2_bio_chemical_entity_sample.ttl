# ISA Tox RO-Crate Profile - SHACL Shapes (MUST / REQUIRED)
# Toxicology extension of the ISA RO-Crate Profile, version 0.1-draft

@prefix bioschemas: <https://bioschemas.org/> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tox: <https://w3id.org/ro/crate/isa-tox/1.0/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tox:BioChemicalEntitySampleShape
    a sh:NodeShape ;
    sh:name "BioChemicalEntitySample" ;
    sh:description "A biological entity (e.g., cell line) used as a test system in a toxicology study" ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select "SELECT DISTINCT ?this WHERE { ?this <http://schema.org/additionalType> \"BioChemicalEntity\" . }" ;
    ] ;
    sh:property [
        sh:path schema:isBasedOn ;
        sh:minCount 1 ;
        sh:message "Add at least one schema:isBasedOn linking to the source bioschemas:Sample biological entity" ;
    ] .

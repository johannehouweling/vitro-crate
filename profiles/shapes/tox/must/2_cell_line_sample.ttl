# ISA Tox RO-Crate Profile - SHACL Shapes (MUST / REQUIRED)
# Toxicology extension of the ISA RO-Crate Profile, version 0.1-draft

@prefix bioschemas: <https://bioschemas.org/> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tox: <https://w3id.org/ro/crate/isa-tox/1.0/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tox:CellLineSampleShape
    a sh:NodeShape ;
    sh:name "CellLineSample" ;
    sh:description "The cell-based test system (e.g., a cell line) in a toxicology study" ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select "SELECT DISTINCT ?this WHERE { ?this <http://schema.org/additionalType> \"CellLine\" . }" ;
    ] ;
    sh:property [
        sh:path schema:sampleType ;
        sh:minCount 1 ;
        sh:class schema:DefinedTerm ;
        sh:message "Add schema:sampleType as a schema:DefinedTerm categorising the test system (e.g., 'cell line')" ;
    ] .

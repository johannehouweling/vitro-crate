# ISA Tox RO-Crate Profile - SHACL Shapes (MUST / REQUIRED)
# Toxicology extension of the ISA RO-Crate Profile, version 0.1-draft

@prefix bioschemas: <https://bioschemas.org/> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix tox: <https://w3id.org/ro/crate/isa-tox/1.0/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

tox:LabProcessCellCultureShape
    a sh:NodeShape ;
    sh:name "LabProcessCellCulture" ;
    sh:description "A cell culture process in a toxicology study" ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select "SELECT DISTINCT ?this WHERE { ?this <http://schema.org/additionalType> \"CellCulture\" . }" ;
    ] ;
    sh:property [
        sh:path schema:object ;
        sh:minCount 1 ;
        sh:message "Add at least one schema:object linking to bioschemas:Sample input cell line entities" ;
    ] ;
    sh:property [
        sh:path schema:result ;
        sh:minCount 1 ;
        sh:message "Add at least one schema:result linking to bioschemas:Sample output cultured sample entities" ;
    ] ;
    sh:property [
        sh:path schema:additionalProperty ;
        sh:minCount 1 ;
        sh:message "Add at least one schema:additionalProperty linking to schema:PropertyValue entities (e.g., Culture Medium)" ;
    ] .

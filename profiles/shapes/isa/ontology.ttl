@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix bioschemas: <https://bioschemas.org/> .
@prefix isa: <https://w3id.org/ro/crate/isa/1.0/> .
@prefix schema: <http://schema.org/> .

<https://w3id.org/ro/crate/isa/1.0> rdf:type owl:Ontology ;
    owl:versionIRI <https://w3id.org/ro/crate/isa/1.0> .

# Base types used by this profile

bioschemas:LabProcess rdf:type owl:Class ;
    rdfs:label "LabProcess"@en .

bioschemas:LabProtocol rdf:type owl:Class ;
    rdfs:label "LabProtocol"@en .

bioschemas:Sample rdf:type owl:Class ;
    rdfs:label "Sample"@en .

schema:Comment rdf:type owl:Class ;
    rdfs:label "Comment"@en .

schema:Dataset rdf:type owl:Class ;
    rdfs:label "Dataset"@en .

schema:DefinedTerm rdf:type owl:Class ;
    rdfs:label "DefinedTerm"@en .

schema:MediaObject rdf:type owl:Class ;
    rdfs:label "Data"@en .

schema:Person rdf:type owl:Class ;
    rdfs:label "Person"@en .

schema:PropertyValue rdf:type owl:Class ;
    rdfs:label "PropertyValue"@en .

schema:ScholarlyArticle rdf:type owl:Class ;
    rdfs:label "ScholarlyArticle"@en .

# ISA RO-Crate Profile - discriminated subtypes

isa:Investigation rdf:type owl:Class ;
    rdfs:subClassOf schema:Dataset ;
    rdfs:comment "An ISA Investigation represents the root data entity" ;
    rdfs:label "Investigation"@en .

isa:Study rdf:type owl:Class ;
    rdfs:subClassOf schema:Dataset ;
    rdfs:comment "An ISA Study within an Investigation" ;
    rdfs:label "Study"@en .

isa:Assay rdf:type owl:Class ;
    rdfs:subClassOf schema:Dataset ;
    rdfs:comment "An ISA Assay within a Study" ;
    rdfs:label "Assay"@en .

isa:ParameterValue rdf:type owl:Class ;
    rdfs:subClassOf schema:PropertyValue ;
    rdfs:comment "A parameter value in a LabProcess" ;
    rdfs:label "ParameterValue"@en .

isa:CharacteristicValue rdf:type owl:Class ;
    rdfs:subClassOf schema:PropertyValue ;
    rdfs:comment "A characteristic value in a Sample" ;
    rdfs:label "CharacteristicValue"@en .

isa:FactorValue rdf:type owl:Class ;
    rdfs:subClassOf schema:PropertyValue ;
    rdfs:comment "A factor value in a Sample" ;
    rdfs:label "FactorValue"@en .

isa:ComponentValue rdf:type owl:Class ;
    rdfs:subClassOf schema:PropertyValue ;
    rdfs:comment "A protocol component in a LabProtocol" ;
    rdfs:label "ComponentValue"@en .

isa:DOIPropertyValue rdf:type owl:Class ;
    rdfs:subClassOf schema:PropertyValue ;
    rdfs:comment "A PropertyValue representing a DOI" ;
    rdfs:label "DOIPropertyValue"@en .

isa:PubMedIDPropertyValue rdf:type owl:Class ;
    rdfs:subClassOf schema:PropertyValue ;
    rdfs:comment "A PropertyValue representing a PubMedID" ;
    rdfs:label "PubMedIDPropertyValue"@en .

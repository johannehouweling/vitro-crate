# ISA RO-Crate Profile - SHACL Shapes (SHOULD / RECOMMENDED)
# Profile for ISA-based RO-Crates, version 1.0.0-draft.1

@prefix bioschemas: <https://bioschemas.org/> .
@prefix isa: <https://w3id.org/ro/crate/isa/1.0/> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

isa:LabProcessShape
    a sh:NodeShape ;
    sh:targetClass bioschemas:LabProcess ;
    sh:name "LabProcess" ;
    sh:property [
        sh:path schema:object ;
        sh:or ( [ sh:class bioschemas:Sample ] [ sh:class schema:MediaObject ] ) ;
        sh:message "Add schema:object linking to bioschemas:Sample or schema:MediaObject input entities" ;
    ] ;
    sh:property [
        sh:path schema:result ;
        sh:or ( [ sh:class bioschemas:Sample ] [ sh:class schema:MediaObject ] ) ;
        sh:message "Add schema:result linking to bioschemas:Sample or schema:MediaObject output entities" ;
    ] ;
    sh:property [
        sh:path schema:agent ;
        sh:class schema:Person ;
        sh:message "Add schema:agent linking to the schema:Person who performed this process" ;
    ] ;
    sh:property [
        sh:path bioschemas:executesLabProtocol ;
        sh:class bioschemas:LabProtocol ;
        sh:message "Add bioschemas:executesLabProtocol linking to the bioschemas:LabProtocol this process executes" ;
    ] ;
    sh:property [
        sh:path schema:additionalProperty ;
        sh:class schema:PropertyValue ;
        sh:message "Add schema:additionalProperty linking to schema:PropertyValue entities for process parameters" ;
    ] ;
    sh:property [
        sh:path schema:endTime ;
        sh:datatype xsd:dateTime ;
        sh:message "Add a schema:endTime (xsd:dateTime) indicating when the process completed" ;
    ] .

# ISA RO-Crate Profile - SHACL Shapes (SHOULD / RECOMMENDED)
# Profile for ISA-based RO-Crates, version 1.0.0-draft.1

@prefix bioschemas: <https://bioschemas.org/> .
@prefix isa: <https://w3id.org/ro/crate/isa/1.0/> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

isa:PropertyValueShape
    a sh:NodeShape ;
    sh:targetClass schema:PropertyValue ;
    sh:name "PropertyValue" ;
    sh:property [
        sh:path schema:value ;
        sh:message "Add schema:value with the property value (xsd:string or number)" ;
    ] ;
    sh:property [
        sh:path schema:propertyID ;
        sh:nodeKind sh:IRI ;
        sh:message "Add schema:propertyID (IRI) linking to an ontology term for this property key" ;
    ] .

# ISA RO-Crate Profile - SHACL Shapes (SHOULD / RECOMMENDED)
# Profile for ISA-based RO-Crates, version 1.0.0-draft.1

@prefix bioschemas: <https://bioschemas.org/> .
@prefix isa: <https://w3id.org/ro/crate/isa/1.0/> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

isa:PersonShape
    a sh:NodeShape ;
    sh:targetClass schema:Person ;
    sh:name "Person" ;
    sh:property [
        sh:path schema:familyName ;
        sh:datatype xsd:string ;
        sh:message "Add a schema:familyName (xsd:string) to the Person" ;
    ] ;
    sh:property [
        sh:path schema:email ;
        sh:message "Add a schema:email (xsd:string) to the Person" ;
    ] ;
    sh:property [
        sh:path schema:affiliation ;
        sh:class schema:Organization ;
        sh:message "Add schema:affiliation linking to a schema:Organization entity" ;
    ] ;
    sh:property [
        sh:path schema:identifier ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:nodeKind sh:IRI ] [ sh:class schema:PropertyValue ] ) ;
        sh:message "Add schema:identifier (xsd:string, IRI, or schema:PropertyValue) with a persistent identifier (e.g., ORCID)" ;
    ] ;
    sh:property [
        sh:path schema:jobTitle ;
        sh:class schema:DefinedTerm ;
        sh:message "Add schema:jobTitle as a schema:DefinedTerm describing the person's role" ;
    ] .

# ISA RO-Crate Profile - SHACL Shapes (SHOULD / RECOMMENDED)
# Profile for ISA-based RO-Crates, version 1.0.0-draft.1

@prefix bioschemas: <https://bioschemas.org/> .
@prefix isa: <https://w3id.org/ro/crate/isa/1.0/> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

isa:LabProtocolShape
    a sh:NodeShape ;
    sh:targetClass bioschemas:LabProtocol ;
    sh:name "LabProtocol" ;
    sh:property [
        sh:path schema:name ;
        sh:datatype xsd:string ;
        sh:message "Add a schema:name (xsd:string) with the protocol title" ;
    ] ;
    sh:property [
        sh:path schema:description ;
        sh:datatype xsd:string ;
        sh:message "Add a schema:description (xsd:string) with a short protocol description" ;
    ] ;
    sh:property [
        sh:path schema:intendedUse ;
        sh:or ( [ sh:class schema:DefinedTerm ] [ sh:datatype xsd:string ] [ sh:nodeKind sh:IRI ] ) ;
        sh:message "Add schema:intendedUse (schema:DefinedTerm, xsd:string, or IRI) for the protocol type" ;
    ] .

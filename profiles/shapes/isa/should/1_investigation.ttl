# ISA RO-Crate Profile - SHACL Shapes (SHOULD / RECOMMENDED)
# Profile for ISA-based RO-Crates, version 1.0.0-draft.1

@prefix bioschemas: <https://bioschemas.org/> .
@prefix isa: <https://w3id.org/ro/crate/isa/1.0/> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

isa:InvestigationShape
    a sh:NodeShape ;
    sh:name "Investigation" ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select "SELECT DISTINCT ?this WHERE { ?this <http://schema.org/additionalType> \"Investigation\" . }" ;
    ] ;
    sh:property [
        sh:path schema:dateCreated ;
        sh:or ( [ sh:datatype xsd:date ] [ sh:datatype xsd:dateTime ] [ sh:datatype xsd:string ] ) ;
        sh:message "Add a schema:dateCreated (ISO 8601 date string) indicating when the Investigation was created" ;
    ] ;
    sh:property [
        sh:path schema:creator ;
        sh:class schema:Person ;
        sh:message "Add at least one schema:creator linking to a schema:Person entity" ;
    ] ;
    sh:property [
        sh:path schema:hasPart ;
        sh:class schema:Dataset ;
        sh:message "Add schema:hasPart linking to schema:Dataset entities representing Studies" ;
    ] .

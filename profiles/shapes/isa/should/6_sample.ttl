# ISA RO-Crate Profile - SHACL Shapes (SHOULD / RECOMMENDED)
# Profile for ISA-based RO-Crates, version 1.0.0-draft.1

@prefix bioschemas: <https://bioschemas.org/> .
@prefix isa: <https://w3id.org/ro/crate/isa/1.0/> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

isa:SampleShape
    a sh:NodeShape ;
    sh:targetClass bioschemas:Sample ;
    sh:name "Sample" ;
    sh:property [
        sh:path schema:additionalProperty ;
        sh:class schema:PropertyValue ;
        sh:message "Add schema:additionalProperty linking to schema:PropertyValue entities for sample characteristics or factors" ;
    ] ;
    sh:property [
        sh:path schema:isBasedOn ;
        sh:class bioschemas:Sample ;
        sh:message "Add schema:isBasedOn linking to the parent bioschemas:Sample this sample was derived from" ;
    ] .

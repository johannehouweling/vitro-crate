# ISA RO-Crate Profile - SHACL Shapes (SHOULD / RECOMMENDED)
# Profile for ISA-based RO-Crates, version 1.0.0-draft.1

@prefix bioschemas: <https://bioschemas.org/> .
@prefix isa: <https://w3id.org/ro/crate/isa/1.0/> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

isa:DefinedTermShape
    a sh:NodeShape ;
    sh:targetClass schema:DefinedTerm ;
    sh:name "DefinedTerm" ;
    sh:property [
        sh:path schema:termCode ;
        sh:datatype xsd:string ;
        sh:message "Add a schema:termCode (xsd:string) with the term identifier within its ontology" ;
    ] .

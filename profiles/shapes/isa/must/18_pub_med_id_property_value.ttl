# ISA RO-Crate Profile - SHACL Shapes (MUST / REQUIRED)
# Profile for ISA-based RO-Crates, version 1.0.0-draft.1

@prefix bioschemas: <https://bioschemas.org/> .
@prefix isa: <https://w3id.org/ro/crate/isa/1.0/> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

isa:PubMedIDPropertyValueShape
    a sh:NodeShape ;
    sh:name "PubMedIDPropertyValue" ;
    sh:description "A PropertyValue representing a PubMedID" ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select "SELECT DISTINCT ?this WHERE { ?this <http://schema.org/name> \"PubMedID\" . }" ;
    ] ;
    sh:property [
        sh:path schema:propertyID ;
        sh:hasValue <http://purl.obolibrary.org/obo/OBI_0001617> ;
        sh:minCount 1 ;
        sh:message "Set schema:propertyID to 'http://purl.obolibrary.org/obo/OBI_0001617' (IRI) to identify this PropertyValue as a PubMedID" ;
    ] .

# ISA RO-Crate Profile - SHACL Shapes (MUST / REQUIRED)
# Profile for ISA-based RO-Crates, version 1.0.0-draft.1

@prefix bioschemas: <https://bioschemas.org/> .
@prefix isa: <https://w3id.org/ro/crate/isa/1.0/> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

isa:ScholarlyArticleShape
    a sh:NodeShape ;
    sh:targetClass schema:ScholarlyArticle ;
    sh:name "ScholarlyArticle" ;
    sh:description "A publication in ISA" ;
    sh:property [
        sh:path schema:headline ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Add a schema:headline (xsd:string) with the article title" ;
    ] ;
    sh:property [
        sh:path schema:identifier ;
        sh:minCount 1 ;
        sh:message "Add at least one schema:identifier (xsd:string, IRI, or schema:PropertyValue) with the DOI, PubMedID, or other article identifier" ;
    ] .

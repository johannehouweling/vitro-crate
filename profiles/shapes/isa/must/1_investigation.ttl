# ISA RO-Crate Profile - SHACL Shapes (MUST / REQUIRED)
# Profile for ISA-based RO-Crates, version 1.0.0-draft.1

@prefix bioschemas: <https://bioschemas.org/> .
@prefix isa: <https://w3id.org/ro/crate/isa/1.0/> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

isa:InvestigationShape
    a sh:NodeShape ;
    sh:name "Investigation" ;
    sh:description "An ISA Investigation represents the root data entity" ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select "SELECT DISTINCT ?this WHERE { ?this <http://schema.org/additionalType> \"Investigation\" . }" ;
    ] ;
    sh:property [
        sh:path schema:identifier ;
        sh:minCount 1 ;
        sh:message "Add at least one schema:identifier (xsd:string or IRI) to the Investigation" ;
    ] ;
    sh:property [
        sh:path schema:name ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Add a schema:name (xsd:string) with the Investigation title" ;
    ] ;
    sh:property [
        sh:path schema:description ;
        sh:minCount 1 ;
        sh:datatype xsd:string ;
        sh:message "Add a schema:description (xsd:string) to the Investigation" ;
    ] ;
    sh:property [
        sh:path schema:license ;
        sh:minCount 1 ;
        sh:message "Add a schema:license (xsd:string or IRI); use 'ALL RIGHTS RESERVED BY THE AUTHORS' if none available" ;
    ] ;
    sh:property [
        sh:path schema:datePublished ;
        sh:minCount 1 ;
        sh:or ( [ sh:datatype xsd:date ] [ sh:datatype xsd:dateTime ] [ sh:datatype xsd:string ] ) ;
        sh:message "Add a schema:datePublished (ISO 8601 date string) to the Investigation" ;
    ] .

# ISA RO-Crate Profile - SHACL Shapes (COULD / OPTIONAL)
# Profile for ISA-based RO-Crates, version 1.0.0-draft.1

@prefix bioschemas: <https://bioschemas.org/> .
@prefix isa: <https://w3id.org/ro/crate/isa/1.0/> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

isa:StudyShape
    a sh:NodeShape ;
    sh:name "Study" ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select "SELECT DISTINCT ?this WHERE { ?this <http://schema.org/additionalType> \"Study\" . }" ;
    ] ;
    sh:property [
        sh:path schema:citation ;
        sh:class schema:ScholarlyArticle ;
        sh:message "Add schema:citation linking to schema:ScholarlyArticle entities for related publications" ;
    ] ;
    sh:property [
        sh:path schema:comment ;
        sh:class schema:Comment ;
        sh:message "Add schema:comment linking to schema:Comment entities" ;
    ] ;
    sh:property [
        sh:path schema:dateModified ;
        sh:or ( [ sh:datatype xsd:date ] [ sh:datatype xsd:dateTime ] [ sh:datatype xsd:string ] ) ;
        sh:message "Add a schema:dateModified (ISO 8601 date string) if the Study has been modified" ;
    ] ;
    sh:property [
        sh:path schema:url ;
        sh:nodeKind sh:IRI ;
        sh:message "Add a schema:url (IRI) pointing to the Study metadata file" ;
    ] .

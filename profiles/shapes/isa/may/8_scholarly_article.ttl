# ISA RO-Crate Profile - SHACL Shapes (COULD / OPTIONAL)
# Profile for ISA-based RO-Crates, version 1.0.0-draft.1

@prefix bioschemas: <https://bioschemas.org/> .
@prefix isa: <https://w3id.org/ro/crate/isa/1.0/> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

isa:ScholarlyArticleShape
    a sh:NodeShape ;
    sh:targetClass schema:ScholarlyArticle ;
    sh:name "ScholarlyArticle" ;
    sh:property [
        sh:path schema:creativeWorkStatus ;
        sh:class schema:DefinedTerm ;
        sh:message "Add schema:creativeWorkStatus as a schema:DefinedTerm describing the publication lifecycle stage" ;
    ] ;
    sh:property [
        sh:path schema:comment ;
        sh:class schema:Comment ;
        sh:message "Add schema:comment linking to schema:Comment entities" ;
    ] .

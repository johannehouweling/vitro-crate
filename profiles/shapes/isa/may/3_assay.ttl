# ISA RO-Crate Profile - SHACL Shapes (COULD / OPTIONAL)
# Profile for ISA-based RO-Crates, version 1.0.0-draft.1

@prefix bioschemas: <https://bioschemas.org/> .
@prefix isa: <https://w3id.org/ro/crate/isa/1.0/> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

isa:AssayShape
    a sh:NodeShape ;
    sh:name "Assay" ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select "SELECT DISTINCT ?this WHERE { ?this <http://schema.org/additionalType> \"Assay\" . }" ;
    ] ;
    sh:property [
        sh:path schema:variableMeasured ;
        sh:or ( [ sh:datatype xsd:string ] [ sh:class schema:PropertyValue ] ) ;
        sh:message "Add schema:variableMeasured (xsd:string or schema:PropertyValue) for the target variable (e.g., protein concentration)" ;
    ] ;
    sh:property [
        sh:path schema:comment ;
        sh:class schema:Comment ;
        sh:message "Add schema:comment linking to schema:Comment entities" ;
    ] ;
    sh:property [
        sh:path schema:url ;
        sh:nodeKind sh:IRI ;
        sh:message "Add a schema:url (IRI) pointing to the Assay metadata file" ;
    ] .

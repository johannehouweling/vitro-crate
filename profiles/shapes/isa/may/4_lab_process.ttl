# ISA RO-Crate Profile - SHACL Shapes (COULD / OPTIONAL)
# Profile for ISA-based RO-Crates, version 1.0.0-draft.1

@prefix bioschemas: <https://bioschemas.org/> .
@prefix isa: <https://w3id.org/ro/crate/isa/1.0/> .
@prefix schema: <http://schema.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

isa:LabProcessShape
    a sh:NodeShape ;
    sh:targetClass bioschemas:LabProcess ;
    sh:name "LabProcess" ;
    sh:property [
        sh:path schema:disambiguatingDescription ;
        sh:datatype xsd:string ;
        sh:message "Add schema:disambiguatingDescription (xsd:string) for additional process comments" ;
    ] .
